{
  "C_Cpp.intelliSenseEngine": "default",
  "idf.extensionActivationMode": "always",
  "idf.openOcdConfigs": [
    "board/esp32s3-builtin.cfg"
  ],
  "idf.port": "detect",
  "idf.customExtraVars": {
    "IDF_TARGET": "esp32s3"
  },
  "clangd.arguments": [
    "--background-index",
    "--query-driver=**",
    "--compile-commands-dir=${workspaceFolder}/build/usb-v2"
  ],
  "idf.buildPath": "${workspaceFolder}/build/usb-v2",
  "idf.sdkconfigFilePath": "${workspaceFolder}/build/usb-v2/sdkconfig"
}
